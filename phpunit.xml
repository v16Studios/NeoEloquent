<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         bootstrap="vendor/autoload.php"
         backupStaticAttributes="false"
         colors="true"
         verbose="true"
         convertErrorsToExceptions="true"
         convertDeprecationsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false"
         beStrictAboutTestsThatDoNotTestAnything="false"
>
    <testsuites>
        <testsuite name="NeoEloquent Test Suite">
            <directory suffix=".php">./tests/Vinelab</directory>
            <directory suffix=".php">./tests/functional</directory>
        </testsuite>
        <testsuite name="Laravel compatibility">
            <file>./tests/compatibility/CompatibilityTest.php</file>
            <file>./tests/compatibility/GraphCompatibilityTest.php</file>
        </testsuite>
        <testsuite name="Neo4j transactions">
            <file>./tests/compatibility/GraphTransactionTest.php</file>
        </testsuite>
        <testsuite name="Release acceptance">
            <file>./tests/compatibility/GraphReleaseTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
